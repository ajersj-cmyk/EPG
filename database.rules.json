{
  "rules": {
    // Cave Trivia — home party game.
    // Open read/write under rooms/ so any TV or phone on the night can play
    // with zero accounts. Do NOT use these rules for anything sensitive:
    // player names, scores, answers and wagers are visible to anyone with
    // the database URL. Everything else defaults to deny.
    "rooms": {
      ".read": true,
      ".write": true
    }
  }
}
